<!-- Opens the real VbOcrScanForm against a running server, scans an invoice and saves
     screenshots. Windows only (it shows a window). See README.md in the folder above. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>15</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>Off</OptionInfer>
    <MyType>Empty</MyType>
    <RootNamespace></RootNamespace>
    <StartupObject>DialogTest</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\VbOcrClient.vb" />
    <Compile Include="..\..\VbOcrScanForm.vb" />
    <Compile Include="Program.vb" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
